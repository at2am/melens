{
  "name": "@melens/map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "tsc --project ../shared/tsconfig.json",
    "build": "tsc --project tsconfig.json",
