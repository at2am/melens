    "dev": "node --watch src/dev-server.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.1.0",
    "@melens/shared": "0.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
