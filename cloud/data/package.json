{
  "name": "@melens/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-manifests.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && cd dist && node --test",
    "ingest": "node dist/src/jobs/ingest.js",
    "verify": "node dist/src/jobs/verify.js",
    "probe": "node dist/src/jobs/probe.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.1.0",
    "@google-cloud/bigquery-storage": "6.1.0",
    "@google-cloud/storage": "8.2.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "read-excel-file": "9.3.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
