    "@google/genai": "2.28.0",
    "@melens/shared": "0.1.0",
    "google-auth-library": "11.2.0",
    "firebase-admin": "14.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
